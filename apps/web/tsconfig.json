{
  "compilerOptions": {
    "paths": {
      "$/*": ["./*"]
    },
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true
  },
  "extends": "../../tsconfig.json",
  "include": ["**/*.ts", "**/*.tsx"]
}
