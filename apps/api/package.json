{
  "name": "@teris/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --target=bun main.ts --outdir dist",
    "dev": "bun --watch main.ts",
    "start": "bun main.ts",
    "type:check": "bun --bun run tsc --noEmit",
    "db:generate": "bun --bun run drizzle-kit generate --name",
    "db:migrate": "bun --bun run drizzle-kit migrate",
    "db:push": "bun --bun run drizzle-kit push",
    "db:studio": "bun --bun run drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@teris/auth": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.3",
    "lodash-es": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/lodash-es": "catalog:",
    "@types/pg": "^8.20.2",
    "drizzle-kit": "^0.31.10",
    "pg": "^8.22.0"
  }
}
